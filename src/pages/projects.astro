---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { withBase } from '../utils/url';
---

<BaseLayout
  title={`Projects — ${profile.name}`}
  description={`Open-source robotics, active perception, and time-series forecasting codebases by ${profile.name}.`}
>
  <header>
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">
      Projects &amp; Software
    </h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      Open-source implementations, robotic perception frameworks, and time-series forecasting libraries.
    </p>
  </header>

  <section class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
    {projects.map((project) => (
      <article class="flex flex-col p-5 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/40 hover:border-blue-300 dark:hover:border-blue-700/80 transition-colors">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
              {project.title}
            </h2>
            <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-0.5">
              {project.year}
            </p>
          </div>
          <span
            class:list={[
              'text-[11px] font-medium px-2 py-0.5 rounded-full border shrink-0',
              project.status === 'Active'
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60'
                : 'bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700',
            ]}
          >
            {project.status}
          </span>
        </div>

        <p class="mt-2 text-sm font-medium text-blue-700 dark:text-blue-400">
          {project.subtitle}
        </p>

        <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-400 leading-relaxed flex-1">
          {project.description}
        </p>

        {project.metrics && (
          <p class="mt-3 text-xs font-mono text-slate-500 dark:text-slate-400">
            {project.metrics}
          </p>
        )}

        <div class="mt-4 flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300">
              {tag}
            </span>
          ))}
        </div>

        <div class="mt-4 pt-3.5 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center gap-3 text-xs font-medium">
          {project.links.github && (
            <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="academic-link">
              GitHub &rarr;
            </a>
          )}
          {project.links.docs && (
            <a href={project.links.docs} target="_blank" rel="noopener noreferrer" class="academic-link">
              Docs
            </a>
          )}
          {project.links.demo && (
            <a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="academic-link">
              Live Demo
            </a>
          )}
          {project.links.paper && (
            <a href={withBase(project.links.paper)} class="academic-link">
              Paper
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
