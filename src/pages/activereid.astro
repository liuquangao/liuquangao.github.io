---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

const simBars = [
  { label: 'Very Heavy', before: 39.6, nbv: 80.6, ours: 90.7 },
  { label: 'Heavy', before: 69.9, nbv: 84.1, ours: 92.5 },
  { label: 'Moderate', before: 85.0, nbv: 89.4, ours: 95.2 },
  { label: 'Light', before: 91.2, nbv: 93.4, ours: 98.2 },
  { label: 'Overall (906)', before: 71.4, nbv: 86.9, ours: 94.2 },
];

const realRows = [
  { level: 'Heavy (>50%)', runs: 72, dis: '0.721 → 0.831', r1Before: '26.4%', r1After: '81.9%' },
  { level: 'Light (<50%)', runs: 72, dis: '0.790 → 0.882', r1Before: '37.5%', r1After: '87.5%' },
  { level: 'Overall (Zero-Shot)', runs: 144, dis: '0.756 → 0.857', r1Before: '31.9%', r1After: '84.7%' },
];

const rolloutScenes = [
  {
    code: 'SCENE 01 · KITCHENETTE',
    title: 'Table & Chair Occlusion',
    caption: 'Navigates around dining chairs to capture a clear frontal view.',
    video: '/media/clip-scene1-kitchenette.mp4',
  },
  {
    code: 'SCENE 02 · OFFICE LAB',
    title: 'Heavy Box & Desk Clutter',
    caption: 'Crosses the office aisle to resolve heavy box occlusion.',
    video: '/media/clip-scene2-office.mp4',
  },
  {
    code: 'SCENE 03 · LOBBY DOORWAY',
    title: 'Corridor Entrance Occlusion',
    caption: 'Steps into open lobby space and aligns to the target.',
    video: '/media/clip-scene3-lobby.mp4',
  },
  {
    code: '3DGS DATA · ISAAC SIM',
    title: '375 Photorealistic Scenes',
    caption: '28,765 scored RGB-D frames for zero-shot Sim2Real transfer.',
    video: '/media/clip-3dgs-data.mp4',
  },
];

const bibtex = `@article{liu2026activereid,
  title={ActiveReID: Target-Conditioned Active Viewpoint Optimization for Mobile Robot Person Re-Identification},
  author={Liu, Quangao and Wang, Ning and Zhao, Zixian and Zhang, Xingchen},
  journal={IEEE Robotics and Automation Letters (RA-L)},
  year={2026}
}`;
---

<BaseLayout
  title="ActiveReID — Interactive Project Page (IEEE RA-L 2026)"
  description="ActiveReID: Target-Conditioned Active Viewpoint Optimization for Mobile Robot Person Re-Identification. IEEE RA-L 2026."
>
  <!-- Top Scroll Progress Bar -->
  <div class="fixed top-0 left-0 right-0 z-50 h-0.5 bg-transparent pointer-events-none">
    <div id="scroll-progress" class="h-full w-0 bg-gradient-to-r from-blue-600 via-sky-500 to-indigo-50 transition-[width] duration-75"></div>
  </div>

  <!-- Full-bleed wide showcase container (breaks out of BaseLayout's narrow reading column) -->
  <div class="w-screen relative left-1/2 -translate-x-1/2 px-5 sm:px-8 lg:px-14 overflow-x-clip">
    <div class="max-w-6xl mx-auto">

      <!-- HERO -->
      <section class="reveal-block text-center max-w-4xl mx-auto pt-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950/50 dark:text-blue-300 dark:border-blue-800/60">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-blue-400 animate-pulse"></span>
          IEEE RA-L 2026
        </div>

        <h1 class="mt-4 font-serif text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1] text-slate-900 dark:text-slate-50">
          ActiveReID
          <span class="block mt-1.5 text-xl sm:text-2xl font-normal text-slate-600 dark:text-slate-400">
            Target-Conditioned Active Viewpoint Optimization for Mobile Robot Person Re-Identification
          </span>
        </h1>

        <p class="mt-4 text-sm text-slate-700 dark:text-slate-300">
          <strong class="font-semibold text-slate-900 dark:text-white">Quangao Liu</strong>,
          Ning Wang, Zixian Zhao, Xingchen Zhang<sup>*</sup> ·
          <span class="text-slate-500 dark:text-slate-400">Fusion Intelligence Lab, University of Exeter</span>
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
          <a
            href="https://github.com/liuquangao/ActiveReID"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-blue-700 text-white hover:bg-blue-800 dark:bg-blue-600 dark:hover:bg-blue-500 transition-colors"
          >
            Code &amp; Data ↗
          </a>
          <a
            href={withBase('/blog/3dgs-perception-and-vln-scene-understanding')}
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:border-blue-500 transition-colors"
          >
            3DGS &amp; VLN Blog →
          </a>
          <a
            href="#bibtex"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-mono border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-blue-700 transition-colors"
          >
            BibTeX ↓
          </a>
        </div>
      </section>

      <!-- KPI STRIP -->
      <section class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-4 reveal-block" id="kpi-band">
        <div class="p-5 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/50 text-center">
          <div class="font-mono text-3xl font-bold text-blue-700 dark:text-blue-400">
            <span class="count-up" data-target="94.2" data-decimals="1">0.0</span>%
          </div>
          <div class="mt-1 text-xs font-medium text-slate-700 dark:text-slate-300">Sim Rank-1 (↑ from 71.4%)</div>
        </div>
        <div class="p-5 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/50 text-center">
          <div class="font-mono text-3xl font-bold text-emerald-600 dark:text-emerald-400">
            <span class="count-up" data-target="84.7" data-decimals="1">0.0</span>%
          </div>
          <div class="mt-1 text-xs font-medium text-slate-700 dark:text-slate-300">Real Rank-1 (↑ from 31.9%)</div>
        </div>
        <div class="p-5 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/50 text-center">
          <div class="font-mono text-3xl font-bold text-slate-900 dark:text-slate-100">
            <span class="count-up" data-target="28765" data-decimals="0">0</span>
          </div>
          <div class="mt-1 text-xs font-medium text-slate-700 dark:text-slate-300">3DGS RGB-D Frames</div>
        </div>
        <div class="p-5 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/50 text-center">
          <div class="font-mono text-3xl font-bold text-indigo-600 dark:text-indigo-400">Zero-Shot</div>
          <div class="mt-1 text-xs font-medium text-slate-700 dark:text-slate-300">Unitree Go2 · 144 Runs</div>
        </div>
      </section>

      <!-- SCROLL-DRIVEN STORYTELLING (WIDE 2-COLUMN) -->
      <section class="mt-16 reveal-block" id="motivation-scrolly">
        <div class="flex items-baseline justify-between gap-2 mb-6">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-slate-100">
            How ActiveReID Works
          </h2>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-400">Scroll or click steps ↓</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Left: Concise 1-sentence steps -->
          <div class="lg:col-span-5 space-y-5">
            <div class="story-step is-active cursor-pointer rounded-2xl border p-5 transition-all duration-300" data-step="0">
              <div class="font-mono text-[11px] font-semibold text-rose-600 dark:text-rose-400">01 / PASSIVE REID</div>
              <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">Fixed Views Fail Under Occlusion</h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                Furniture and poor angles hide identity cues—passive ReID drops to 31.9% Rank-1 in real clutter.
              </p>
            </div>

            <div class="story-step cursor-pointer rounded-2xl border p-5 transition-all duration-300" data-step="1">
              <div class="font-mono text-[11px] font-semibold text-blue-700 dark:text-blue-400">02 / TARGET-CONDITIONED</div>
              <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">Predict Dense View Quality Map S</h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                Given RGB-D + target bbox, one forward pass scores every navigable floor pixel—no gallery needed.
              </p>
            </div>

            <div class="story-step cursor-pointer rounded-2xl border p-5 transition-all duration-300" data-step="2">
              <div class="font-mono text-[11px] font-semibold text-amber-600 dark:text-amber-400">03 / BEYOND VISIBILITY</div>
              <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">Visibility + Discriminability</h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                Moving to argmax S jointly maximizes visibility and identity cues (+7.3% Rank-1 over NBV-res).
              </p>
            </div>

            <div class="story-step cursor-pointer rounded-2xl border p-5 transition-all duration-300" data-step="3">
              <div class="font-mono text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">04 / ZERO-SHOT 3DGS SIM2REAL</div>
              <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">Isaac Sim 3DGS → Unitree Go2</h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                Trained purely on 3DGS scenes; transfers directly to real hardware (31.9% → 84.7% Rank-1).
              </p>
            </div>
          </div>

          <!-- Right: Large Sticky Visual Stage -->
          <div class="lg:col-span-7 lg:sticky lg:top-24">
            <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/60 overflow-hidden shadow-sm">
              <div class="flex items-center justify-between px-5 py-3 border-b border-slate-200/80 dark:border-slate-800 bg-slate-50/90 dark:bg-slate-900/90">
                <span id="stage-badge" class="font-mono text-xs font-semibold text-rose-600 dark:text-rose-400">
                  STAGE 01 // PASSIVE OCCLUDED VIEW
                </span>
                <div class="flex items-center gap-1.5">
                  <span class="stage-dot w-5 h-2 rounded-full bg-blue-600 transition-all"></span>
                  <span class="stage-dot w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 transition-all"></span>
                  <span class="stage-dot w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 transition-all"></span>
                  <span class="stage-dot w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 transition-all"></span>
                </div>
              </div>

              <div class="p-4 bg-slate-50/50 dark:bg-slate-950/60">
                <svg viewBox="0 0 460 280" class="w-full h-auto block">
                  <defs>
                    <pattern id="story-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                      <path d="M 24 0 L 0 0 0 24" fill="none" stroke="currentColor" stroke-opacity="0.08" stroke-width="1" />
                    </pattern>
                    <radialGradient id="quality-heat" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#ef4444" stop-opacity="0.65" />
                      <stop offset="45%" stop-color="#f59e0b" stop-opacity="0.38" />
                      <stop offset="80%" stop-color="#3b82f6" stop-opacity="0.16" />
                      <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                    </radialGradient>
                  </defs>

                  <rect width="460" height="280" rx="12" fill="url(#story-grid)" />
                  <circle id="svg-heatmap" cx="322" cy="154" r="96" fill="url(#quality-heat)" class="transition-all duration-700 opacity-0 scale-75 origin-center" />

                  <rect x="148" y="108" width="104" height="46" rx="8" class="fill-slate-300 dark:fill-slate-700 stroke-slate-400 dark:stroke-slate-600" stroke-width="1.5" />
                  <text x="200" y="135" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" class="fill-slate-600 dark:fill-slate-300">OCCLUDER</text>

                  <g id="svg-target">
                    <circle cx="250" cy="56" r="15" fill="#10b981" />
                    <text x="250" y="60" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" font-weight="700" fill="#fff">ID</text>
                    <rect id="svg-bbox" x="228" y="34" width="44" height="44" rx="5" fill="none" stroke="#10b981" stroke-width="2" stroke-dasharray="4 3" class="transition-opacity duration-500 opacity-30" />
                    <text x="250" y="25" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" class="fill-slate-700 dark:fill-slate-300">Target Person</text>
                  </g>

                  <line id="svg-sight-blocked" x1="94" y1="216" x2="240" y2="66" stroke="#ef4444" stroke-width="2" stroke-dasharray="5 5" class="transition-opacity duration-500 opacity-90" />
                  <line id="svg-sight-clear" x1="322" y1="154" x2="256" y2="68" stroke="#10b981" stroke-width="2.5" class="transition-opacity duration-500 opacity-0" />
                  <path id="svg-path" d="M 94 216 Q 225 242, 322 154" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-dasharray="6 5" class="transition-opacity duration-500 opacity-0" />

                  <g id="svg-argmax" class="transition-opacity duration-500 opacity-0">
                    <circle cx="322" cy="154" r="12" fill="none" stroke="#ef4444" stroke-width="2" />
                    <text x="340" y="158" font-family="JetBrains Mono, monospace" font-size="11" fill="#dc2626">argmax S</text>
                  </g>

                  <g id="svg-robot" style="transform: translate(94px, 216px); transition: transform 850ms cubic-bezier(0.22, 1, 0.36, 1);">
                    <circle cx="0" cy="0" r="17" fill="#1d4ed8" />
                    <circle cx="0" cy="0" r="24" fill="none" stroke="#3b82f6" stroke-opacity="0.35" stroke-width="1.5" />
                    <text x="0" y="4" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" font-weight="700" fill="#ffffff">Go2</text>
                  </g>
                </svg>
              </div>

              <div class="grid grid-cols-3 gap-2 px-5 py-3.5 border-t border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/90 font-mono text-xs">
                <div>
                  <span class="text-[10px] text-slate-500">VISIBILITY</span>
                  <div id="stage-vis" class="mt-0.5 text-sm font-semibold text-rose-600 dark:text-rose-400">0.456</div>
                </div>
                <div>
                  <span class="text-[10px] text-slate-500">DISCRIMINABILITY</span>
                  <div id="stage-dis" class="mt-0.5 text-sm font-semibold text-slate-800 dark:text-slate-200">0.756</div>
                </div>
                <div>
                  <span class="text-[10px] text-slate-500">RANK-1 REID</span>
                  <div id="stage-r1" class="mt-0.5 text-sm font-semibold text-rose-600 dark:text-rose-400">31.9%</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PER-SCENE REAL-WORLD INFERENCE ROLLOUTS (BIG WIDE 2x2 GALLERY) -->
      <section class="mt-18 reveal-block">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-5">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-slate-100">
            Real-World Inference Rollouts &amp; 3DGS Data
          </h2>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
            RGB · ZED 2i Depth · Predicted View Quality Map
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {rolloutScenes.map((scene) => (
            <article class="stagger-card overflow-hidden rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/50 shadow-xs">
              <video
                class="scene-clip w-full aspect-video object-cover bg-black"
                muted
                loop
                playsinline
                controls
                preload="metadata"
              >
                <source src={withBase(scene.video)} type="video/mp4" />
              </video>
              <div class="px-4 py-3 flex items-baseline justify-between gap-3">
                <div>
                  <span class="font-mono text-[10px] font-semibold text-blue-700 dark:text-blue-400">{scene.code}</span>
                  <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{scene.title}</h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400">{scene.caption}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- INTERACTIVE VIEW QUALITY PLAYGROUND -->
      <section class="mt-18 reveal-block">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-slate-100">
            Interactive Multi-Person Playground
          </h2>
          <span class="font-mono text-xs text-slate-500 dark:text-slate-400">f(I, D, b) → (q, S)</span>
        </div>

        <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/50 overflow-hidden shadow-xs">
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-slate-200/80 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/80">
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" id="btn-target-a" class="cursor-pointer px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-700 text-white transition-colors">
                Target Person A
              </button>
              <button type="button" id="btn-target-b" class="cursor-pointer px-3 py-1.5 rounded-lg text-xs font-medium border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-blue-500 transition-colors">
                Target Person B
              </button>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" id="btn-move-robot" class="cursor-pointer px-4 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 text-white hover:bg-emerald-700 transition-colors">
                Move Go2 to argmax S →
              </button>
              <button type="button" id="btn-reset-robot" class="cursor-pointer px-3 py-1.5 rounded-lg text-xs font-mono border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300">
                Reset
              </button>
            </div>
          </div>

          <div class="relative w-full h-80 sm:h-96 bg-slate-50 dark:bg-slate-950">
            <canvas id="activereid-canvas" class="w-full h-full block"></canvas>
          </div>

          <div class="grid grid-cols-3 gap-3 px-5 py-3 border-t border-slate-200/80 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/60 font-mono text-xs">
            <div><span class="text-slate-500">s_vis:</span> <strong id="demo-vis" class="text-slate-900 dark:text-slate-100">0.34</strong></div>
            <div><span class="text-slate-500">s_dis:</span> <strong id="demo-dis" class="text-slate-900 dark:text-slate-100">0.72</strong></div>
            <div><span class="text-slate-500">q:</span> <strong id="demo-qual" class="text-blue-700 dark:text-blue-400">0.53 (Move)</strong></div>
          </div>
        </div>
      </section>

      <!-- QUANTITATIVE RESULTS (SIDE-BY-SIDE WIDE) -->
      <section class="mt-18 reveal-block" id="sim-chart-section">
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-slate-100 mb-5">
          Quantitative Results
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
          <!-- Sim Bars -->
          <div class="lg:col-span-7 p-5 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-3.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-xs font-semibold text-slate-800 dark:text-slate-200">Simulation · 906 Runs (Rank-1 %)</span>
              <div class="flex items-center gap-3 text-[11px] font-mono">
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-xs bg-slate-300 dark:bg-slate-600"></span>Before</span>
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-xs bg-sky-400"></span>NBV-res</span>
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-xs bg-blue-700 dark:bg-blue-500"></span>Ours</span>
              </div>
            </div>

            {simBars.map((row) => (
              <div class="space-y-1">
                <div class="flex justify-between text-xs">
                  <span class="font-medium text-slate-700 dark:text-slate-300">{row.label}</span>
                  <span class="font-mono text-slate-500">{row.before}% → <strong class="text-blue-700 dark:text-blue-400">{row.ours}%</strong></span>
                </div>
                <div class="space-y-1">
                  <div class="h-1.5 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                    <div class="anim-bar h-full rounded-full bg-slate-300 dark:bg-slate-600" data-width={`${row.before}%`} style="width: 0%"></div>
                  </div>
                  <div class="h-1.5 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                    <div class="anim-bar h-full rounded-full bg-sky-400" data-width={`${row.nbv}%`} style="width: 0%"></div>
                  </div>
                  <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                    <div class="anim-bar h-full rounded-full bg-blue-700 dark:bg-blue-500" data-width={`${row.ours}%`} style="width: 0%"></div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Real-World Table -->
          <div class="lg:col-span-5 rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900/40 overflow-hidden">
            <div class="px-5 py-3.5 border-b border-slate-200 dark:border-slate-800 font-mono text-xs font-semibold text-slate-800 dark:text-slate-200">
              Real-World Unitree Go2 · 144 Runs
            </div>
            <table class="w-full text-left text-xs">
              <thead class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/90 dark:bg-slate-900/80 font-mono text-[11px] text-slate-500">
                <tr>
                  <th class="px-4 py-2.5">Occlusion</th>
                  <th class="px-4 py-2.5">Dis.</th>
                  <th class="px-4 py-2.5">Rank-1</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200/70 dark:divide-slate-800/70">
                {realRows.map((r) => (
                  <tr class={r.level.startsWith('Overall') ? 'font-semibold bg-blue-50/40 dark:bg-blue-950/20' : ''}>
                    <td class="px-4 py-3 text-slate-800 dark:text-slate-200">{r.level}</td>
                    <td class="px-4 py-3 font-mono text-slate-600 dark:text-slate-300">{r.dis}</td>
                    <td class="px-4 py-3 font-mono">
                      <span class="text-slate-400">{r.r1Before}</span> → <strong class="text-blue-700 dark:text-blue-400">{r.r1After}</strong>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- BIBTEX -->
      <section id="bibtex" class="mt-16 reveal-block">
        <div class="flex items-center justify-between">
          <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">BibTeX</h2>
          <button
            type="button"
            id="copy-bib-btn"
            class="cursor-pointer px-3 py-1 rounded-md text-xs font-mono border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-blue-500 hover:text-blue-700 transition-colors"
          >
            Copy
          </button>
        </div>
        <pre class="mt-2.5 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/70 overflow-x-auto font-mono text-xs leading-relaxed text-slate-800 dark:text-slate-200"><code id="bib-code">{bibtex}</code></pre>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .reveal-block {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal-block.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .stagger-card {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 550ms ease, transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .is-visible .stagger-card {
    opacity: 1;
    transform: translateY(0);
  }
  .is-visible .stagger-card:nth-child(2) { transition-delay: 90ms; }
  .is-visible .stagger-card:nth-child(3) { transition-delay: 180ms; }
  .is-visible .stagger-card:nth-child(4) { transition-delay: 270ms; }
  .anim-bar {
    transition: width 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .story-step {
    border-color: rgba(203, 213, 225, 0.7);
    background-color: rgba(255, 255, 255, 0.65);
    opacity: 0.6;
  }
  :global(.dark) .story-step {
    border-color: rgba(30, 41, 59, 0.85);
    background-color: rgba(15, 23, 42, 0.35);
  }
  .story-step.is-active {
    border-color: #2563eb;
    background-color: #ffffff;
    opacity: 1;
    transform: translateX(4px);
    box-shadow: 0 8px 24px -12px rgba(37, 99, 235, 0.22);
  }
  :global(.dark) .story-step.is-active {
    border-color: #3b82f6;
    background-color: rgba(15, 23, 42, 0.88);
  }
</style>

<script is:inline>
  // Scroll progress bar
  const progressBar = document.getElementById('scroll-progress');
  window.addEventListener('scroll', () => {
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, (window.scrollY / docHeight) * 100) : 0;
    if (progressBar) progressBar.style.width = `${pct}%`;
  }, { passive: true });

  // Scroll reveal + Count-Up + Bar animations
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');

      if (entry.target.id === 'kpi-band') {
        entry.target.querySelectorAll('.count-up').forEach((el) => {
          if (el.dataset.done) return;
          el.dataset.done = '1';
          const target = parseFloat(el.dataset.target || '0');
          const decimals = parseInt(el.dataset.decimals || '0', 10);
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min(1, (now - start) / 850);
            const val = target * (1 - Math.pow(1 - p, 3));
            el.textContent = decimals > 0 ? val.toFixed(decimals) : Math.round(val).toLocaleString();
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }

      if (entry.target.id === 'sim-chart-section') {
        entry.target.querySelectorAll('.anim-bar').forEach((bar, i) => {
          setTimeout(() => { bar.style.width = bar.dataset.width || '0%'; }, i * 40);
        });
      }
      revealObserver.unobserve(entry.target);
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-block').forEach((el) => revealObserver.observe(el));

  // Auto-play muted scene videos when visible
  const videoObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const vid = entry.target;
      if (!(vid instanceof HTMLVideoElement)) return;
      if (entry.isIntersecting) vid.play().catch(() => {});
      else vid.pause();
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.scene-clip').forEach((v) => videoObserver.observe(v));

  // Scrollytelling controller
  (() => {
    const steps = Array.from(document.querySelectorAll('.story-step'));
    const badge = document.getElementById('stage-badge');
    const visEl = document.getElementById('stage-vis');
    const disEl = document.getElementById('stage-dis');
    const r1El = document.getElementById('stage-r1');
    const dots = document.querySelectorAll('.stage-dot');

    const heatmap = document.getElementById('svg-heatmap');
    const bbox = document.getElementById('svg-bbox');
    const sightBlocked = document.getElementById('svg-sight-blocked');
    const sightClear = document.getElementById('svg-sight-clear');
    const pathEl = document.getElementById('svg-path');
    const argmaxEl = document.getElementById('svg-argmax');
    const robotEl = document.getElementById('svg-robot');

    const states = [
      { badge: 'STAGE 01 // PASSIVE OCCLUDED VIEW', badgeCls: 'text-rose-600 dark:text-rose-400', vis: '0.456', dis: '0.756', r1: '31.9%', r1Cls: 'text-rose-600 dark:text-rose-400', heatmap: false, bbox: false, blocked: true, clear: false, path: false, argmax: false, robotPos: 'translate(94px, 216px)' },
      { badge: 'STAGE 02 // DENSE VIEW QUALITY MAP S', badgeCls: 'text-blue-700 dark:text-blue-400', vis: 'Scoring', dis: 'Single Pass', r1: 'No Gallery', r1Cls: 'text-blue-700 dark:text-blue-400', heatmap: true, bbox: true, blocked: true, clear: false, path: true, argmax: true, robotPos: 'translate(94px, 216px)' },
      { badge: 'STAGE 03 // MOVE TO OPTIMAL VIEWPOINT', badgeCls: 'text-amber-600 dark:text-amber-400', vis: '0.794 (Sim)', dis: '0.900 (Sim)', r1: '94.2% (Sim)', r1Cls: 'text-blue-700 dark:text-blue-400', heatmap: true, bbox: true, blocked: false, clear: true, path: true, argmax: true, robotPos: 'translate(322px, 154px)' },
      { badge: 'STAGE 04 // ZERO-SHOT 3DGS → UNITREE GO2', badgeCls: 'text-emerald-600 dark:text-emerald-400', vis: 'Clear View', dis: '0.857 (Real)', r1: '84.7% (+52.8 pp)', r1Cls: 'text-emerald-600 dark:text-emerald-400', heatmap: true, bbox: true, blocked: false, clear: true, path: true, argmax: true, robotPos: 'translate(322px, 154px)' },
    ];

    function activateStep(idx) {
      const s = states[idx] || states[0];
      steps.forEach((el, i) => el.classList.toggle('is-active', i === idx));
      dots.forEach((d, i) => {
        d.className = `stage-dot h-2 rounded-full transition-all ${i === idx ? 'w-5 bg-blue-600' : 'w-2 bg-slate-300 dark:bg-slate-700'}`;
      });
      if (badge) { badge.textContent = s.badge; badge.className = `font-mono text-xs font-semibold ${s.badgeCls}`; }
      if (visEl) visEl.textContent = s.vis;
      if (disEl) disEl.textContent = s.dis;
      if (r1El) { r1El.textContent = s.r1; r1El.className = `mt-0.5 text-sm font-semibold ${s.r1Cls}`; }
      if (heatmap) { heatmap.style.opacity = s.heatmap ? '1' : '0'; heatmap.style.transform = s.heatmap ? 'scale(1)' : 'scale(0.75)'; }
      if (bbox) bbox.style.opacity = s.bbox ? '1' : '0.3';
      if (sightBlocked) sightBlocked.style.opacity = s.blocked ? '0.9' : '0';
      if (sightClear) sightClear.style.opacity = s.clear ? '1' : '0';
      if (pathEl) pathEl.style.opacity = s.path ? '1' : '0';
      if (argmaxEl) argmaxEl.style.opacity = s.argmax ? '1' : '0';
      if (robotEl) robotEl.style.transform = s.robotPos;
    }

    const stepObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) activateStep(parseInt(entry.target.getAttribute('data-step') || '0', 10));
      });
    }, { rootMargin: '-32% 0px -38% 0px', threshold: 0.1 });

    steps.forEach((el, i) => {
      stepObserver.observe(el);
      el.addEventListener('click', () => activateStep(i));
    });
    activateStep(0);
  })();

  // BibTeX copy
  const copyBtn = document.getElementById('copy-bib-btn');
  const bibCode = document.getElementById('bib-code');
  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(bibCode?.textContent || '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
  });

  // Interactive Canvas Playground
  (() => {
    const canvas = document.getElementById('activereid-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const btnA = document.getElementById('btn-target-a');
    const btnB = document.getElementById('btn-target-b');
    const btnMove = document.getElementById('btn-move-robot');
    const btnReset = document.getElementById('btn-reset-robot');
    const visEl = document.getElementById('demo-vis');
    const disEl = document.getElementById('demo-dis');
    const qualEl = document.getElementById('demo-qual');

    const startRobot = { x: 0.16, y: 0.78 };
    const obstacles = [
      { x: 0.28, y: 0.44, w: 0.18, h: 0.14, label: 'Desk' },
      { x: 0.56, y: 0.50, w: 0.12, h: 0.24, label: 'Partition' },
    ];
    const targets = {
      A: { x: 0.38, y: 0.24, label: 'Person A', best: { x: 0.50, y: 0.28 }, before: { vis: 0.34, dis: 0.72 }, after: { vis: 0.89, dis: 0.93 } },
      B: { x: 0.78, y: 0.34, label: 'Person B', best: { x: 0.76, y: 0.72 }, before: { vis: 0.29, dis: 0.69 }, after: { vis: 0.86, dis: 0.91 } },
    };

    let activeKey = 'A';
    let robot = { ...startRobot };
    let moving = false;
    let progress = 0;

    function updateReadout(p) {
      const t = targets[activeKey];
      const vis = t.before.vis + (t.after.vis - t.before.vis) * p;
      const dis = t.before.dis + (t.after.dis - t.before.dis) * p;
      const q = 0.5 * (vis + dis);
      if (visEl) visEl.textContent = vis.toFixed(2);
      if (disEl) disEl.textContent = dis.toFixed(2);
      if (qualEl) qualEl.textContent = p > 0.85 ? `${q.toFixed(2)} (Optimal)` : `${q.toFixed(2)} (Move)`;
    }

    function setActiveTarget(key) {
      activeKey = key; robot = { ...startRobot }; moving = false; progress = 0; updateReadout(0);
      if (btnA && btnB) {
        const activeCls = ['bg-blue-700', 'text-white', 'font-semibold'];
        const idleCls = ['border', 'border-slate-300', 'dark:border-slate-700', 'text-slate-700', 'dark:text-slate-300'];
        if (key === 'A') { btnA.classList.add(...activeCls); btnA.classList.remove(...idleCls); btnB.classList.remove(...activeCls); btnB.classList.add(...idleCls); }
        else { btnB.classList.add(...activeCls); btnB.classList.remove(...idleCls); btnA.classList.remove(...activeCls); btnA.classList.add(...idleCls); }
      }
    }

    btnA?.addEventListener('click', () => setActiveTarget('A'));
    btnB?.addEventListener('click', () => setActiveTarget('B'));
    btnMove?.addEventListener('click', () => { moving = true; });
    btnReset?.addEventListener('click', () => { robot = { ...startRobot }; moving = false; progress = 0; updateReadout(0); });

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    function draw() {
      const rect = canvas.getBoundingClientRect();
      const w = rect.width, h = rect.height;
      const isDark = document.documentElement.classList.contains('dark');
      const t = targets[activeKey];

      if (moving && progress < 1) {
        progress = Math.min(1, progress + 0.022);
        const e = 1 - Math.pow(1 - progress, 3);
        robot.x = startRobot.x + (t.best.x - startRobot.x) * e;
        robot.y = startRobot.y + (t.best.y - startRobot.y) * e;
        updateReadout(e);
      }

      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = isDark ? 'rgba(148,163,184,0.1)' : 'rgba(100,116,139,0.12)';
      ctx.lineWidth = 1;
      for (let x = 28; x < w; x += 28) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
      for (let y = 28; y < h; y += 28) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }

      const gx = t.best.x * w, gy = t.best.y * h;
      const grad = ctx.createRadialGradient(gx, gy, 8, gx, gy, Math.min(w, h) * 0.42);
      grad.addColorStop(0, 'rgba(239, 68, 68, 0.55)');
      grad.addColorStop(0.35, 'rgba(245, 158, 11, 0.35)');
      grad.addColorStop(0.7, 'rgba(59, 130, 246, 0.16)');
      grad.addColorStop(1, 'rgba(59, 130, 246, 0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);

      obstacles.forEach((ob) => {
        ctx.fillStyle = isDark ? '#1e293b' : '#cbd5e1';
        ctx.strokeStyle = isDark ? '#475569' : '#64748b';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.roundRect(ob.x * w, ob.y * h, ob.w * w, ob.h * h, 8); ctx.fill(); ctx.stroke();
        ctx.fillStyle = isDark ? '#94a3b8' : '#475569';
        ctx.font = '11px "JetBrains Mono", monospace';
        ctx.fillText(ob.label, ob.x * w + 8, ob.y * h + 18);
      });

      ctx.save();
      ctx.strokeStyle = isDark ? '#38bdf8' : '#1d4ed8';
      ctx.setLineDash([5, 5]); ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(startRobot.x * w, startRobot.y * h); ctx.lineTo(gx, gy); ctx.stroke();
      ctx.restore();

      ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(gx, gy, 9, 0, Math.PI * 2); ctx.stroke();
      ctx.fillStyle = isDark ? '#fca5a5' : '#b91c1c';
      ctx.font = '10px "JetBrains Mono", monospace';
      ctx.fillText('argmax S', gx + 12, gy + 4);

      ['A', 'B'].forEach((k) => {
        const pt = targets[k], px = pt.x * w, py = pt.y * h, isTarget = k === activeKey;
        ctx.fillStyle = isTarget ? '#10b981' : isDark ? '#64748b' : '#94a3b8';
        ctx.beginPath(); ctx.arc(px, py, 11, 0, Math.PI * 2); ctx.fill();
        if (isTarget) { ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2; ctx.strokeRect(px - 17, py - 17, 34, 34); }
        ctx.fillStyle = isDark ? '#f1f5f9' : '#0f172a';
        ctx.font = '11px "JetBrains Mono", monospace';
        ctx.fillText(pt.label, px - 24, py - 22);
      });

      const rx = robot.x * w, ry = robot.y * h;
      ctx.strokeStyle = progress > 0.8 ? 'rgba(16,185,129,0.7)' : 'rgba(239,68,68,0.5)';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(rx, ry); ctx.lineTo(t.x * w, t.y * h); ctx.stroke();

      ctx.fillStyle = isDark ? '#3b82f6' : '#1d4ed8';
      ctx.beginPath(); ctx.arc(rx, ry, 10, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 9px "JetBrains Mono", monospace';
      ctx.fillText('Go2', rx - 9, ry + 3);

      requestAnimationFrame(draw);
    }
    updateReadout(0);
    requestAnimationFrame(draw);
  })();
</script>
