---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { cvData } from '../data/cv';
import { publications } from '../data/publications';
import { withBase } from '../utils/url';
---

<BaseLayout
  title={`Curriculum Vitae — ${profile.name}`}
  description={`Curriculum Vitae of ${profile.name}, ${profile.role} at ${profile.affiliation}.`}
>
  <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-slate-800/80">
    <div>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">
        Curriculum Vitae
      </h1>
      <p class="mt-1.5 text-xs font-mono text-slate-500 dark:text-slate-400">
        Last updated: {cvData.lastUpdated}
      </p>
    </div>

    <div class="flex items-center gap-2 print:hidden">
      <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-medium border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:border-blue-400 dark:hover:border-blue-500 hover:text-blue-700 dark:hover:text-blue-400 transition-colors cursor-pointer"
      >
        Print / Save PDF
      </button>
      <a
        href={withBase(cvData.pdfUrl)}
        download
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-medium bg-blue-700 hover:bg-blue-800 dark:bg-blue-600 dark:hover:bg-blue-500 text-white transition-colors"
      >
        Download PDF
      </a>
    </div>
  </header>

  <!-- Education -->
  <section class="mt-8">
    <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
      Education
    </h2>
    <div class="mt-4 space-y-5">
      {cvData.education.map((item) => (
        <div class="flex flex-col sm:flex-row gap-1 sm:gap-6">
          <div class="sm:w-32 shrink-0 font-mono text-xs text-slate-500 dark:text-slate-400 pt-0.5">
            {item.period}
          </div>
          <div class="flex-1">
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">{item.title}</h3>
            <p class="text-sm text-slate-700 dark:text-slate-300">
              {item.organization}
              {item.location && <span class="text-slate-500 dark:text-slate-400"> &middot; {item.location}</span>}
            </p>
            {item.details && (
              <ul class="mt-1.5 space-y-1 text-sm text-slate-600 dark:text-slate-400 list-disc list-inside">
                {item.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Research Experience -->
  <section class="mt-10 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
    <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
      Research Experience
    </h2>
    <div class="mt-4 space-y-5">
      {cvData.experience.map((item) => (
        <div class="flex flex-col sm:flex-row gap-1 sm:gap-6">
          <div class="sm:w-32 shrink-0 font-mono text-xs text-slate-500 dark:text-slate-400 pt-0.5">
            {item.period}
          </div>
          <div class="flex-1">
            <h3 class="font-semibold text-slate-900 dark:text-slate-100">{item.title}</h3>
            <p class="text-sm text-slate-700 dark:text-slate-300">
              {item.organization}
              {item.location && <span class="text-slate-500 dark:text-slate-400"> &middot; {item.location}</span>}
            </p>
            {item.details && (
              <ul class="mt-1.5 space-y-1 text-sm text-slate-600 dark:text-slate-400 list-disc list-inside">
                {item.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Selected Publications Summary -->
  <section class="mt-10 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="flex items-baseline justify-between">
      <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
        Publications
      </h2>
      <a href={withBase('/publications')} class="text-xs font-medium text-blue-700 dark:text-blue-400 hover:underline print:hidden">
        View full details &amp; BibTeX &rarr;
      </a>
    </div>
    <ol class="mt-4 space-y-3 list-decimal list-inside text-sm text-slate-700 dark:text-slate-300">
      {publications.map((pub) => (
        <li class="leading-relaxed">
          <span class="font-medium text-slate-900 dark:text-slate-100">{pub.title}.</span>{' '}
          <span class="text-slate-600 dark:text-slate-400">{pub.authors.join(', ')}.</span>{' '}
          <em class="text-slate-700 dark:text-slate-300">{pub.venue}</em> ({pub.year}).
        </li>
      ))}
    </ol>
  </section>

  <!-- Honors & Awards -->
  <section class="mt-10 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
    <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
      Honors &amp; Awards
    </h2>
    <div class="mt-4 space-y-3">
      {cvData.awards.map((item) => (
        <div class="flex flex-col sm:flex-row gap-1 sm:gap-6 text-sm">
          <div class="sm:w-32 shrink-0 font-mono text-xs text-slate-500 dark:text-slate-400 pt-0.5">
            {item.period}
          </div>
          <div class="flex-1">
            <span class="font-medium text-slate-900 dark:text-slate-100">{item.title}</span>
            <span class="text-slate-600 dark:text-slate-400"> — {item.organization}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Teaching & Service -->
  <section class="mt-10 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
    <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
      Teaching &amp; Academic Service
    </h2>
    <div class="mt-4 space-y-4">
      {cvData.teachingAndService.map((item) => (
        <div class="flex flex-col sm:flex-row gap-1 sm:gap-6 text-sm">
          <div class="sm:w-32 shrink-0 font-mono text-xs text-slate-500 dark:text-slate-400 pt-0.5">
            {item.period}
          </div>
          <div class="flex-1">
            <div class="font-medium text-slate-900 dark:text-slate-100">{item.title}</div>
            <div class="text-slate-600 dark:text-slate-400">{item.organization}</div>
            {item.details && (
              <ul class="mt-1 space-y-1 text-slate-600 dark:text-slate-400 list-disc list-inside">
                {item.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Technical Skills -->
  <section class="mt-10 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
    <h2 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
      Technical Skills
    </h2>
    <div class="mt-4 space-y-2.5 text-sm">
      {cvData.skills.map((group) => (
        <div class="flex flex-col sm:flex-row gap-1 sm:gap-6">
          <div class="sm:w-44 shrink-0 font-medium text-slate-800 dark:text-slate-200">
            {group.category}
          </div>
          <div class="flex-1 text-slate-600 dark:text-slate-400">
            {group.items.join(' · ')}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
