---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
import { withBase, formatDate, estimateReadingTime } from '../../utils/url';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout
  title={`${post.data.title} — ${profile.name}`}
  description={post.data.description}
>
  <article>
    <!-- Back Link -->
    <a
      href={withBase('/blog')}
      class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
    >
      &larr; Back to all notes
    </a>

    <!-- Post Header -->
    <header class="mt-5 pb-6 border-b border-slate-200/80 dark:border-slate-800/80">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>&middot;</span>
        <span>{estimateReadingTime(post.body || '')}</span>
        {post.data.updatedDate && (
          <>
            <span>&middot;</span>
            <span>Updated {formatDate(post.data.updatedDate)}</span>
          </>
        )}
      </div>

      <h1 class="mt-2.5 font-serif text-3xl sm:text-[2.15rem] font-semibold tracking-tight leading-tight text-slate-900 dark:text-slate-50">
        {post.data.title}
      </h1>

      <p class="mt-3 text-base text-slate-600 dark:text-slate-400 leading-relaxed">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <span class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Table of Contents -->
    {tocHeadings.length > 1 && (
      <details open class="mt-6 p-4 rounded-xl bg-slate-50/90 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800">
        <summary class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 cursor-pointer select-none">
          Table of Contents
        </summary>
        <ul class="mt-3 space-y-1.5 text-sm">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-4' : ''}>
              <a
                href={`#${h.slug}`}
                class="text-slate-600 dark:text-slate-300 hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <!-- Article Body -->
    <div class="prose prose-slate dark:prose-invert max-w-none mt-8 prose-headings:font-semibold prose-a:text-blue-700 dark:prose-a:text-blue-400">
      <Content />
    </div>

    <!-- Prev / Next Navigation -->
    {(prevPost || nextPost) && (
      <nav class="mt-12 pt-6 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          {prevPost && (
            <a
              href={withBase(`/blog/${prevPost.id}`)}
              class="group block p-3.5 rounded-lg border border-slate-200/80 dark:border-slate-800 hover:border-blue-400 dark:hover:border-blue-500 transition-colors"
            >
              <span class="text-xs font-mono text-slate-500 dark:text-slate-400">&larr; Previous</span>
              <div class="mt-1 font-medium text-slate-900 dark:text-slate-100 group-hover:text-blue-700 dark:group-hover:text-blue-400">
                {prevPost.data.title}
              </div>
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {nextPost && (
            <a
              href={withBase(`/blog/${nextPost.id}`)}
              class="group block p-3.5 rounded-lg border border-slate-200/80 dark:border-slate-800 hover:border-blue-400 dark:hover:border-blue-500 transition-colors"
            >
              <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Next &rarr;</span>
              <div class="mt-1 font-medium text-slate-900 dark:text-slate-100 group-hover:text-blue-700 dark:group-hover:text-blue-400">
                {nextPost.data.title}
              </div>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>
