---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { profile } from '../../data/profile';
import { withBase, formatDate, estimateReadingTime } from '../../utils/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout
  title={`Blog & Notes — ${profile.name}`}
  description={`Research notes, derivations, and technical tutorials on robotics, Sim2Real, and time-series modeling by ${profile.name}.`}
>
  <header class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">
        Blog &amp; Research Notes
      </h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Technical notes on Sim2Real transfer, robotic manipulation &amp; navigation, time-series forecasting, and research workflows.
      </p>
    </div>
    <a
      href={withBase('/rss.xml')}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-blue-400 dark:hover:border-blue-500 hover:text-blue-700 dark:hover:text-blue-400 transition-colors shrink-0"
      title="Subscribe via RSS"
    >
      <SocialIcons name="rss" class="w-3.5 h-3.5" />
      <span>RSS</span>
    </a>
  </header>

  <!-- Tag Filter -->
  {allTags.length > 0 && (
    <div class="mt-6 flex flex-wrap items-center gap-1.5 text-xs">
      <button type="button" class="blog-tag-chip active" data-tag="all">All</button>
      {allTags.map((tag) => (
        <button type="button" class="blog-tag-chip" data-tag={tag}>
          {tag}
        </button>
      ))}
    </div>
  )}

  <!-- Post List -->
  <section class="mt-8 divide-y divide-slate-200/75 dark:divide-slate-800/75">
    {posts.map((post) => (
      <article
        class="blog-item py-6 first:pt-1"
        data-tags={post.data.tags.join('|')}
      >
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span>&middot;</span>
          <span>{estimateReadingTime(post.body || '')}</span>
        </div>

        <h2 class="mt-1.5 font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">
          <a
            href={withBase(`/blog/${post.id}`)}
            class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
          >
            {post.data.title}
          </a>
        </h2>

        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {post.data.description}
        </p>

        {post.data.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300">
                {tag}
              </span>
            ))}
          </div>
        )}
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  @reference "../../styles/global.css";
  .blog-tag-chip {
    @apply px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-400 dark:hover:border-blue-500 transition-colors cursor-pointer;
  }
  .blog-tag-chip.active {
    @apply bg-blue-700 dark:bg-blue-500 text-white border-blue-700 dark:border-blue-500;
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-tag-chip'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.blog-item'));

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const selected = chip.dataset.tag || 'all';
      chips.forEach((c) => c.classList.toggle('active', c === chip));

      items.forEach((item) => {
        const tags = (item.dataset.tags || '').split('|');
        const show = selected === 'all' || tags.includes(selected);
        item.classList.toggle('hidden', !show);
      });
    });
  });
</script>
